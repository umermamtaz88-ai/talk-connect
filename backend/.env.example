# Copy to .env for local; set the same keys in FastAPI Cloud via:
#   fastapi cloud env set KEY

SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional direct (non-pooler) URL for migrations
MIGRATIONS_DATABASE_URL=
# Use memory fallback when Redis is unavailable (cloud-safe)
REDIS_URL=redis://localhost:6379/0
DEBUG=false

# Comma-separated extra CORS origins (Vercel previews, custom domains)
CORS_ORIGINS_EXTRA=https://talkconnect.vercel.app,https://talk-connect-2nec.vercel.app,https://talk-connect-pearl.vercel.app

GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest
AI_RATE_LIMIT_PER_MINUTE=20

OTP_SECRET=
OTP_TTL_MINUTES=10
RESEND_API_KEY=
RESEND_FROM=Talk Connect <onboarding@resend.dev>
